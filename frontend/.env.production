# Production - placeholder only. Replace with the real deployed API origin
# before shipping a build.
#
# IMPORTANT (Create React App behavior, not specific to this file): REACT_APP_*
# variables are baked into the JS bundle at BUILD time (`npm run build`),
# not read at runtime like an ASP.NET Core appsettings value - editing this
# file after a build has already been produced has no effect on it. Override
# it either by editing this file before building, or by setting the
# environment variable in whatever runs the build (e.g. a CI pipeline step:
# `REACT_APP_API_URL=https://api.testvault.example.com npm run build`),
# which takes precedence over this file.
REACT_APP_API_URL=https://api.testvault.example.com
