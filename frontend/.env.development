# Local development - matches TestVault.Web/Properties/launchSettings.json's
# "http" profile (dotnet run's default). Bare origin only, no /api or
# /hubs suffix - apiClient.js and signalRService.js each append their own
# path (see src/services/apiClient.js).
#
# CRA loads .env.development automatically when running `npm start`
# (NODE_ENV=development) - see .env.production for the build-time
# equivalent, and src/services/apiClient.js for what happens if this is
# left unset.
REACT_APP_API_URL=http://localhost:5238
